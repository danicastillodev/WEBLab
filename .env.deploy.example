# Configuración del MCP de despliegue (mcp/deploy).
# Copiar a .env.deploy — ese archivo está en .gitignore porque lleva el token.

# --- cPanel -----------------------------------------------------------------
# Host de cPanel (el dominio o el hostname del servidor, sin https://)
CPANEL_HOST=midominio.com
CPANEL_PORT=2083
CPANEL_USER=usuariocpanel

# Token de API: cPanel -> Security -> Manage API Tokens -> Create.
# No hace falta darle todos los permisos, pero sí acceso a Git Version Control
# y a File Manager (para leer los logs).
CPANEL_TOKEN=

# Ruta absoluta del repositorio clonado en cPanel. La muestra la propia pantalla
# de Git Version Control, típicamente:
CPANEL_REPO_ROOT=/home/usuariocpanel/repositories/WEBLab

# Carpeta de la aplicación relativa al home (la misma que usa .cpanel.yml).
# Se usa para leer storage/logs/laravel.log.
CPANEL_APP_DIR=weblab

# Algunos hosting sirven el puerto 2083 con un certificado que no valida.
# Poner true solo si la conexión falla por TLS.
CPANEL_INSECURE_TLS=false

# --- Git --------------------------------------------------------------------
# Rama de código y rama de artefactos compilados. No hace falta ningún token de
# GitHub: se reusa el git local, que ya está autenticado.
SOURCE_BRANCH=main
DEPLOY_BRANCH=deploy
GIT_REMOTE=origin
